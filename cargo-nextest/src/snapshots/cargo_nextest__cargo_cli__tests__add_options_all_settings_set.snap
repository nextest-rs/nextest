---
source: cargo-nextest/src/cargo_cli.rs
expression: "&cargo_cli.all_args()[1..]"
---
[
    "--color=never",
    "test",
    "--manifest-path=path/to/Cargo.toml",
    "--package=foo",
    "--package=bar@1.2",
    "--workspace",
    "--exclude=baz",
    "--lib",
    "--bin=my-bin",
    "--bins",
    "--example=-dash-example",
    "--examples",
    "--test=-dash-test",
    "--tests",
    "--bench=my-bench",
    "--benches",
    "--all-targets",
    "--features=feat-a feat-b",
    "--features=-dash-feature",
    "--all-features",
    "--no-default-features",
    "--jobs=-1",
    "--release",
    "--profile=my-profile",
    "--target=x86_64-unknown-linux-gnu",
    "--target-dir=path/to/target dir",
    "--unit-graph",
    "--timings=html,json",
    "--frozen",
    "--locked",
    "--offline",
    "--quiet",
    "--config=build.rustflags=[\"-Dwarnings\"]",
    "--config=path/to/config.toml",
    "--verbose",
    "--verbose",
    "--ignore-rust-version",
    "--future-incompat-report",
    "-Zunstable-options",
    "-Zbuild-std",
]
